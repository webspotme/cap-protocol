{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webspotme/cap-protocol/schema/resource.schema.json",
  "title": "cap-protocol Resource",
  "description": "A single capability resource in a cap-protocol registry. See SPEC.md §2.",
  "type": "object",
  "required": [
    "cap_id",
    "schema_version",
    "layer",
    "source",
    "what",
    "account",
    "state",
    "lifecycle",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "cap_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,127}$",
      "description": "Globally unique. Lowercase, underscore-separated, 2-128 chars."
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "layer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Layer name. The protocol defines a baseline list (see SPEC §2.1.1) but implementations MAY extend it."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Resolvable identifier (file path, MCP server.tool, container name, env var reference, etc.). MUST NOT contain secret material."
    },
    "what": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "account": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Identity acting under this capability, or 'N/A'. MUST NOT contain secret material."
    },
    "state": {
      "type": "object",
      "required": ["current", "since", "health"],
      "additionalProperties": false,
      "properties": {
        "current": {
          "enum": [
            "proposed",
            "registered",
            "verified",
            "active",
            "degraded",
            "recovered",
            "deprecated",
            "archived",
            "rejected"
          ]
        },
        "since": { "type": "string", "format": "date-time" },
        "health": { "enum": ["green", "yellow", "red"] },
        "last_verified": {
          "anyOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "verifier": {
          "anyOf": [
            { "type": "string", "maxLength": 256 },
            { "type": "null" }
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["proposed_by", "proposed_at"],
      "additionalProperties": false,
      "properties": {
        "proposed_by": { "type": "string", "minLength": 1, "maxLength": 256 },
        "proposed_at": { "type": "string", "format": "date-time" },
        "registered_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "verified_at":   { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "activated_at":  { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "deprecated_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "archived_at":   { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "description": "Semver MAJOR.MINOR.PATCH"
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "description": "Schema-shaped description of inputs. Bounded shallow object: keys are input names, values are short type descriptors. Not a JSON Schema document — keep it human-readable.",
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "maxLength": 256 },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "maxLength": 64 },
                  "required": { "type": "boolean" },
                  "description": { "type": "string", "maxLength": 256 }
                }
              }
            ]
          }
        },
        "outputs": {
          "description": "Short string or shallow object describing outputs.",
          "anyOf": [
            { "type": "string", "maxLength": 1024 },
            { "type": "null" },
            {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": {
                "anyOf": [
                  { "type": "string", "maxLength": 256 },
                  { "type": "null" }
                ]
              }
            }
          ]
        },
        "side_effects": { "type": "string", "enum": ["none", "read-only", "writes-local", "writes-remote", "irreversible"] }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "HARD": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "rate_limit": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "account_lock": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "added_by": { "type": "string", "maxLength": 256 },
        "evidence": { "type": "string", "maxLength": 1024 }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composes_with": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
          "uniqueItems": true,
          "maxItems": 64
        },
        "superseded_by": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
            { "type": "null" }
          ]
        },
        "supersedes": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,127}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 64 },
      "uniqueItems": true,
      "maxItems": 32
    }
  },
  "$defs": {
    "nonNullDateTime": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "properties": { "current": { "const": "registered" } } } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["proposed_at", "registered_at"],
            "properties": {
              "registered_at": { "$ref": "#/$defs/nonNullDateTime" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "properties": { "current": { "const": "verified" } } } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["proposed_at", "registered_at", "verified_at"],
            "properties": {
              "registered_at": { "$ref": "#/$defs/nonNullDateTime" },
              "verified_at": { "$ref": "#/$defs/nonNullDateTime" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "properties": { "current": { "const": "active" } } } } },
      "then": {
        "properties": {
          "state": {
            "required": ["current", "since", "health", "last_verified"],
            "properties": {
              "last_verified": { "$ref": "#/$defs/nonNullDateTime" }
            }
          },
          "lifecycle": {
            "required": ["proposed_at", "registered_at", "verified_at", "activated_at"],
            "properties": {
              "registered_at": { "$ref": "#/$defs/nonNullDateTime" },
              "verified_at": { "$ref": "#/$defs/nonNullDateTime" },
              "activated_at": { "$ref": "#/$defs/nonNullDateTime" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "properties": { "current": { "const": "degraded" } } } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["proposed_at", "registered_at", "verified_at", "activated_at"],
            "properties": {
              "registered_at": { "$ref": "#/$defs/nonNullDateTime" },
              "verified_at": { "$ref": "#/$defs/nonNullDateTime" },
              "activated_at": { "$ref": "#/$defs/nonNullDateTime" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "properties": { "current": { "const": "recovered" } } } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["proposed_at", "registered_at", "verified_at", "activated_at"],
            "properties": {
              "registered_at": { "$ref": "#/$defs/nonNullDateTime" },
              "verified_at": { "$ref": "#/$defs/nonNullDateTime" },
              "activated_at": { "$ref": "#/$defs/nonNullDateTime" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "properties": { "current": { "const": "deprecated" } } } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["proposed_at", "registered_at", "verified_at", "activated_at", "deprecated_at"],
            "properties": {
              "registered_at": { "$ref": "#/$defs/nonNullDateTime" },
              "verified_at": { "$ref": "#/$defs/nonNullDateTime" },
              "activated_at": { "$ref": "#/$defs/nonNullDateTime" },
              "deprecated_at": { "$ref": "#/$defs/nonNullDateTime" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "properties": { "current": { "const": "archived" } } } } },
      "then": {
        "properties": {
          "lifecycle": {
            "required": ["proposed_at", "archived_at"],
            "properties": {
              "archived_at": { "$ref": "#/$defs/nonNullDateTime" }
            }
          }
        }
      }
    }
  ]
}
